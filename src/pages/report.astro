---
import Base from "../layouts/Base.astro";

const files = import.meta.glob("../../docs/resolutions/*.md", { eager: true });

function fmtDate(d: unknown): string {
  if (!d) return "";
  return String(d instanceof Date ? d.toISOString() : d).slice(0, 10);
}

function extractTitle(raw: string): string {
  for (const line of raw.split("\n")) {
    if (/^# [^#]/.test(line)) return line.slice(2).trim();
  }
  return "";
}

function extractSection(raw: string, keyword: string): string {
  const lines = raw.split("\n");
  let capturing = false;
  const out: string[] = [];
  for (const line of lines) {
    if (line.startsWith("## ")) {
      if (capturing) break;
      if (line.toLowerCase().includes(keyword.toLowerCase())) {
        capturing = true;
      }
      continue;
    }
    if (capturing) out.push(line);
  }
  return out.join("\n").replace(/<!--[\s\S]*?-->/g, "").trim();
}

type Entry = {
  slug: string;
  date: string;
  author: string;
  status: string;
  title: string;
  why: string;
  businessResult: string;
};

const entries: Entry[] = Object.entries(files)
  .filter(([p]) => !p.endsWith("README.md"))
  .map(([p, mod]: [string, any]) => {
    const fm = mod.frontmatter ?? {};
    const raw: string = typeof mod.rawContent === "function" ? mod.rawContent() : "";
    return {
      slug: p.split("/").pop()!.replace(".md", ""),
      date: fmtDate(fm.date),
      author: fm.author ?? "",
      status: fm.status ?? "draft",
      title: extractTitle(raw) || p.split("/").pop()!.replace(".md", "").replace(/-/g, " "),
      why: extractSection(raw, "why"),
      businessResult: extractSection(raw, "business result"),
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date));

const confirmed  = entries.filter(e => e.status === "confirmed");
const pending    = entries.filter(e => e.status === "needs-confirmation");
const today      = new Date().toISOString().slice(0, 10);

const EXAMPLE_RENDERED = {
  title:          `Hero "View resolution log" button made visible`,
  date:           "2026-06-04",
  author:         "Leo Moura",
  why:            `The "View resolution log" button on the home page was invisible — it had no outline or background, so it looked like a line of grey text rather than something you could click. Anyone landing on the home page would see the purple "How it works" button and miss the resolution log entirely. The fix gives the button a subtle border so both options in the hero are clearly recognisable as interactive, while the resolution log link stays visually quieter than the primary action beside it.`,
  businessResult: "",
};

const EXAMPLE_SOURCE = `\
---
work_item: ""
pr: ""
status: confirmed
author: Leo Moura
date: 2026-06-04
---

# Hero "View resolution log" button made visible

## What changed
The \`.btn-ghost\` rule in \`src/pages/index.astro\` — one border property
added using an existing design token (\`var(--border-2)\`).

## How it was done
A single \`border: 1px solid var(--border-2)\` declaration was added to the
existing rule. The token matches card outlines used elsewhere on the page,
so the button fits the design language without introducing anything new.

## Technical result
The element now has a visible 1px outline at rest.
Static build completes with no errors.

## Why / what-for   <!-- confirmed -->
The "View resolution log" button on the home page was invisible — it had no
outline or background, so it looked like a line of grey text rather than
something you could click. Anyone landing on the home page would see the
purple "How it works" button and miss the resolution log entirely. The fix
gives the button a subtle border so both options in the hero are clearly
recognisable as interactive.`;

const EXAMPLE_SPEC = `\
# Fix Spec — Hero ghost button visibility

## What needs to happen
The "View resolution log →" element in the hero must look like a button.
Read docs/task-problem.md for the full description.

Look at .btn-ghost in src/pages/index.astro and figure out why the element
has no visible shape at rest. Apply the minimal fix that makes it clearly
recognisable without competing with the primary button beside it.

## Acceptance criteria
- "View resolution log →" has a visible shape at rest
- It remains less prominent than the filled "How it works" button
- No other elements on the page are affected
- npm run build completes with no errors`;
---

<Base title="Resolution Report — Decobrief" description="Plain-language summary of every confirmed change — for the whole team.">

  <!-- ── DISCLAIMER BANNER ── -->
  <div class="rp-disclaimer">
    <span class="rp-disclaimer-icon">👥</span>
    <div>
      <strong>Non-technical content</strong>
      — This page is written in plain language for designers, product managers,
      and anyone on the team who wasn't in the room. No technical background
      required. Engineers looking for the full record with code details can use
      the <a href="/resolutions">Dev log</a>.
    </div>
  </div>

  <!-- ── HERO ── -->
  <section class="rp-hero">
    <div class="rp-hero-inner">
      <div class="rp-audience-row">
        <span class="rp-audience-pill rp-pill-nontech">For your team</span>
        <span class="rp-audience-pill rp-pill-tech">For engineers</span>
      </div>
      <h1>What changed — and why.</h1>
      <p class="rp-sub">
        Every meaningful change to this project has a plain-language record:
        what the problem was, why the decision was made, and who confirmed it.
        No technical background required to understand it.
      </p>
      <div class="rp-hero-links">
        <a href="#confirmed" class="btn-primary">See confirmed changes</a>
        <a href="/resolutions" class="btn-ghost">Technical log →</a>
      </div>
    </div>
  </section>

  <!-- ── CONFIRMED — non-tech view ── -->
  <section class="rp-section" id="confirmed">
    <div class="rp-inner">
      <div class="rp-section-header">
        <span class="rp-audience-pill rp-pill-nontech">For your team</span>
        <h2>Confirmed changes</h2>
        <p class="rp-section-desc">
          These changes have been reviewed by the engineer who made them.
          The "why" below is their own words, confirmed at the moment the
          work was finished.
        </p>
      </div>

      {confirmed.length === 0 ? (
        <div class="rp-empty">
          <p class="rp-empty-icon">📋</p>
          <p>No confirmed records yet.</p>
          <p class="rp-empty-hint">
            Run the demo below to create the first one, or scroll down to see
            what a confirmed record looks like.
          </p>
        </div>
      ) : (
        <div class="rp-cards">
          {confirmed.map(e => (
            <div class="rp-card">
              <div class="rp-card-meta">
                <span class="badge badge-confirmed">confirmed</span>
                <span class="rp-meta-date">{e.date}</span>
                {e.author && (
                  <span class="rp-meta-author">
                    Confirmed by <strong>{e.author}</strong>
                  </span>
                )}
              </div>
              <h3 class="rp-card-title">{e.title}</h3>
              {e.why && (
                <div class="rp-why-block">
                  <span class="rp-why-label">Why this was done</span>
                  <p class="rp-why-text">{e.why}</p>
                </div>
              )}
              {e.businessResult && (
                <div class="rp-outcome-block">
                  <span class="rp-outcome-label">Expected outcome</span>
                  <p class="rp-outcome-text">{e.businessResult}</p>
                </div>
              )}
              <a href={`/resolutions/${e.slug}`} class="rp-tech-link">
                Full technical record →
              </a>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── PENDING CONFIRMATION — engineer view ── -->
  {pending.length > 0 && (
    <section class="rp-section rp-section-pending" id="pending">
      <div class="rp-inner">
        <div class="rp-section-header">
          <span class="rp-audience-pill rp-pill-tech">For engineers</span>
          <h2>Waiting for your confirmation</h2>
          <p class="rp-section-desc">
            These changes have been documented by the agent. The proposed
            <em>why</em> needs a human to confirm or correct it in one sentence.
          </p>
        </div>

        <div class="rp-cards">
          {pending.map(e => (
            <div class="rp-card rp-card-pending">
              <div class="rp-card-meta">
                <span class="badge badge-needs">needs confirmation</span>
                <span class="rp-meta-date">{e.date}</span>
              </div>
              <h3 class="rp-card-title">{e.title}</h3>

              {e.why && (
                <div class="rp-proposal-block">
                  <span class="rp-proposal-label">Proposed why — agent's draft</span>
                  <p class="rp-proposal-text">{e.why}</p>
                </div>
              )}

              <div class="rp-confirm-how">
                <p class="rp-confirm-title">To confirm, run in your terminal:</p>
                <pre class="rp-confirm-code"><code>{`claude "The proposed why in docs/resolutions/${e.slug}.md is correct. \
Set status: confirmed, author: your name, date: ${today}."`}</code></pre>
                <p class="rp-confirm-or">Or edit the frontmatter directly:</p>
                <pre class="rp-confirm-code"><code>{`status: confirmed\nauthor: your name\ndate: ${today}`}</code></pre>
              </div>

              <a href={`/resolutions/${e.slug}`} class="rp-tech-link">
                View full record →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── HOW IT WORKS IN PRACTICE ── -->
  <section class="rp-section rp-section-alt" id="example">
    <div class="rp-inner">
      <div class="rp-section-header">
        <h2>How it works in practice</h2>
        <p class="rp-section-desc">
          Three documents, one workflow. Below is a real example of each — the
          bug ticket, the fix spec, and the final resolution record shown from
          both perspectives.
        </p>
      </div>

      <!-- Step flow -->
      <div class="rp-steps">
        <div class="rp-step">
          <div class="rp-step-num">01</div>
          <h4>Bug ticket</h4>
          <p>Describes the visible problem in plain language. No solution prescribed.</p>
        </div>
        <div class="rp-step-arrow">→</div>
        <div class="rp-step">
          <div class="rp-step-num">02</div>
          <h4>Fix spec</h4>
          <p>Describes what "done" looks like — acceptance criteria, not implementation.</p>
        </div>
        <div class="rp-step-arrow">→</div>
        <div class="rp-step">
          <div class="rp-step-num">03</div>
          <h4>Agent fixes + documents</h4>
          <p>Reads both files, finds the root cause, applies the fix, drafts the record.</p>
        </div>
        <div class="rp-step-arrow">→</div>
        <div class="rp-step">
          <div class="rp-step-num">04</div>
          <h4>Human confirms why</h4>
          <p>One sentence. Status set to confirmed. Record committed permanently.</p>
        </div>
      </div>

      <!-- Fix spec example -->
      <div class="rp-doc-example">
        <div class="rp-doc-label">
          <span class="rp-audience-pill rp-pill-tech">docs/fix-spec.md</span>
          <span class="rp-doc-caption">Acceptance criteria — no implementation prescribed</span>
        </div>
        <pre class="rp-code-block"><code>{EXAMPLE_SPEC}</code></pre>
      </div>

      <!-- Resolution record — both views -->
      <div class="rp-doc-label" style="margin-top: 3rem;">
        <span class="rp-doc-caption" style="font-size:1rem; font-weight:600; color: var(--text);">
          The resolution record — two views of the same file
        </span>
      </div>
      <div class="rp-split">

        <!-- Non-tech view -->
        <div class="rp-split-panel">
          <div class="rp-split-label">
            <span class="rp-audience-pill rp-pill-nontech">Non-tech view</span>
            <span class="rp-doc-caption">What a PM, designer, or stakeholder reads</span>
          </div>
          <div class="rp-card rp-card-example">
            <div class="rp-card-meta">
              <span class="badge badge-confirmed">confirmed</span>
              <span class="rp-meta-date">{EXAMPLE_RENDERED.date}</span>
              <span class="rp-meta-author">
                Confirmed by <strong>{EXAMPLE_RENDERED.author}</strong>
              </span>
            </div>
            <h3 class="rp-card-title">{EXAMPLE_RENDERED.title}</h3>
            <div class="rp-why-block">
              <span class="rp-why-label">Why this was done</span>
              <p class="rp-why-text">{EXAMPLE_RENDERED.why}</p>
            </div>
          </div>
        </div>

        <!-- Markdown source -->
        <div class="rp-split-panel">
          <div class="rp-split-label">
            <span class="rp-audience-pill rp-pill-tech">Markdown source</span>
            <span class="rp-doc-caption">What lives in docs/resolutions/ alongside the code</span>
          </div>
          <pre class="rp-code-block rp-code-scroll"><code>{EXAMPLE_SOURCE}</code></pre>
        </div>

      </div><!-- /rp-split -->
    </div>
  </section>

  <!-- ── TRY IT CTA ── -->
  <section class="rp-section rp-section-cta">
    <div class="rp-inner rp-inner-narrow" style="text-align:center;">
      <h2>Create your first record</h2>
      <p class="rp-section-desc" style="margin-bottom:2rem;">
        This project ships with a deliberate bug, a ticket, and a fix spec.
        Ask the agent to fix it — the resolution record writes itself.
      </p>
      <pre class="rp-prompt-block"><code>Read the bug ticket in docs/task-problem.md and the fix spec in
docs/fix-spec.md. Find and fix the issue in the code. Then write
the resolution record following the agent instructions in README.md.</code></pre>
      <div style="margin-top:2rem; display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a href="/#how-it-works" class="btn-primary">How the workflow works</a>
        <a href="/resolutions" class="btn-ghost">Technical log →</a>
      </div>
    </div>
  </section>

</Base>

